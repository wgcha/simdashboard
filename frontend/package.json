{
  "name": "analysis-canvas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "generate:api": "node scripts/generate-api-client.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node scripts/check-architecture-self-test.mjs",
    "test:preferences": "node --experimental-strip-types scripts/workspace-preferences-self-test.mjs",
    "test:api": "node --experimental-transform-types scripts/shared-api-self-test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.17.0",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.2",
    "recharts": "^2.15.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
