+        <ReferenceLine y={overview.threshold} stroke="#f8c15c" strokeDasharray="6 5" label={{ value: '기준 75', fill: '#f8c15c', position: 'right' }} />
+        <Bar dataKey="stress" name="최대 응력" fill="#5b8ff9" radius={[6, 6, 0, 0]} />
+      </BarChart>
