+function TimeSeriesWidget({ overview }: { overview: LoadCaseOverview }) {
+  const byTime = new Map<number, Record<string, number>>()
+  overview.time_series.forEach((point) => {
+    const row = byTime.get(point.time_value) ?? { time: point.time_value }
+    row[edgeKey(point.variable_key)] = point.value
+    byTime.set(point.time_value, row)
+  })
+  const data = [...byTime.values()]
+  return (
+    <ResponsiveContainer width="100%" height="100%">
+      <LineChart data={data} margin={{ top: 12, right: 18, left: -10, bottom: 2 }}>
+        <CartesianGrid stroke="#22354b" strokeDasharray="3 5" />
+        <XAxis dataKey="time" stroke="#8295ac" tickLine={false} axisLine={false} unit=" ms" />
+        <YAxis stroke="#8295ac" tickLine={false} axisLine={false} domain={[0, 95]} unit=" MPa" />
+        <Tooltip contentStyle={{ background: '#111e2e', border: '1px solid #2c425b', borderRadius: 10 }} />
+        <Legend />
