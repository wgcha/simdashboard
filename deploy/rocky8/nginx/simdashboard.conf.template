server {
    listen 443 ssl http2;
    server_name __REPLACE_SERVER_NAME__;

    ssl_certificate __REPLACE_TLS_CERTIFICATE__;
    ssl_certificate_key __REPLACE_TLS_CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    root __REPLACE_RELEASE_ROOT__/frontend/dist;
    index index.html;
    # The application accepts video media up to 500 MiB; leave multipart room.
    client_max_body_size 512m;

    location = /api/health {
        proxy_pass http://127.0.0.1:__REPLACE_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:__REPLACE_API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /assets/ {
        # Vite emits JS/CSS under /assets. Serve those from the release first;
        # only legacy backend public assets fall through to FastAPI.
        try_files $uri @backend_assets;
    }

    location @backend_assets {
        proxy_pass http://127.0.0.1:__REPLACE_API_PORT__;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
