# Copy this file outside the extracted bundle, set mode 0600, and replace every
# CHANGE_ME value. The installer reads this as a trusted root-owned shell file.

# Public HTTPS endpoint and existing certificate files.
# Development-only: install-offline.sh --dev-http skips TLS settings, uses
# password auth and HTTP port 80. Set SERVER_NAME to the server IP/host and
# leave CORS_ALLOWED_ORIGINS empty to derive its HTTP origin. No real accounts.
SERVER_NAME=dashboard.example.com
TLS_CERTIFICATE=/etc/pki/tls/certs/dashboard.example.com.fullchain.pem
TLS_CERTIFICATE_KEY=/etc/pki/tls/private/dashboard.example.com.key
CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# PostgreSQL 18 application and migration roles. URL-encode reserved password
# characters. POSTGRES_OWNER_URL is used only while installing/migrating and is
# never written to the systemd EnvironmentFile.
DATABASE_URL='postgresql+psycopg://simdashboard_app:CHANGE_ME@127.0.0.1:5432/simulation_dashboard'
POSTGRES_OWNER_URL='postgresql+psycopg://simdashboard_owner:CHANGE_ME@127.0.0.1:5432/simulation_dashboard'
SIM_DASH_DATABASE=simulation_dashboard
SIM_DASH_OWNER_ROLE=simdashboard_owner
SIM_DASH_APP_ROLE=simdashboard_app

# Set BOOTSTRAP_DATABASE=1 only when the PostgreSQL server exists but the two
# roles/database do not. POSTGRES_ADMIN_URL and both passwords are installation
# secrets and are not copied into the service EnvironmentFile.
BOOTSTRAP_DATABASE=0
# POSTGRES_ADMIN_URL='postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres'
# SIM_DASH_OWNER_PASSWORD='CHANGE_ME'
# SIM_DASH_APP_PASSWORD='CHANGE_ME'
SIM_DASH_PRESERVE_EXISTING_ROLES=1

# Run Alembic with the owner URL. Keep enabled for normal deployments.
MIGRATE_DATABASE=1
# empty: schema only, reference: install the deterministic example/reference set.
SEED_MODE=empty

# Production authentication. password is self-contained; oidc additionally
# requires the OIDC and usually the HTTP directory settings below.
AUTH_MODE=password
AUTH_SECRET_KEY=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TOKEN_TTL_MINUTES=480
AUTH_COOKIE_SECURE=true

# Optional first password-mode administrator. Leave blank when provisioning the
# account separately or when AUTH_MODE=oidc. Remove this secret from the staging
# config after installation.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_DISPLAY_NAME='Initial administrator'
# INITIAL_ADMIN_PASSWORD='CHANGE_ME_TO_AT_LEAST_12_CHARACTERS'

DIRECTORY_MODE=local
# OIDC_ISSUER_URL=https://idp.intranet.example
# OIDC_CLIENT_ID=analysis-canvas
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_REDIRECT_URI=https://dashboard.example.com/api/auth/oidc/callback
# OIDC_LOGIN_SUCCESS_URL=https://dashboard.example.com/
# OIDC_LOGIN_FAILURE_URL=https://dashboard.example.com/login
# DIRECTORY_MODE=http
# DIRECTORY_API_BASE_URL=https://directory.intranet.example
# DIRECTORY_API_SEARCH_PATH=/employees/search
# DIRECTORY_API_TOKEN=CHANGE_ME
# DIRECTORY_API_TIMEOUT_SECONDS=3
# DIRECTORY_API_RESULT_LIMIT=20

# Service and connection-pool sizing. The installer refuses a pool budget that
# exceeds POSTGRES_MAX_CONNECTIONS minus POSTGRES_RESERVED_CONNECTIONS.
API_PORT=8000
UVICORN_WORKERS=2
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_RESERVED_CONNECTIONS=10
POSTGRES_REQUEST_POOL_SIZE=5
POSTGRES_REQUEST_MAX_OVERFLOW=10
POSTGRES_REQUEST_POOL_TIMEOUT_SECONDS=10
POSTGRES_MEDIA_POOL_SIZE=10
POSTGRES_MEDIA_MAX_OVERFLOW=5
POSTGRES_MEDIA_POOL_TIMEOUT_SECONDS=10
POSTGRES_POOL_RECYCLE_SECONDS=1800

# Installation policy. Rocky Linux 8.6 or later (8.x) is supported. The
# installation still requires the Python 3.12.13 patch pinned in .python-version.
# Set to 0 only after approving and recording a patch-version policy exception.
REQUIRE_EXACT_PYTHON=1
INSTALL_OS_PACKAGES=1
CONFIGURE_SELINUX=1
CONFIGURE_FIREWALL=1
START_SERVICES=1

# Optional internal PyPI mirror for an online installation. An offline bundle
# with wheelhouse/ ignores this setting.
# PIP_INDEX_URL=https://pypi.company.example/simple
# PIP_CERT=/etc/pki/ca-trust/source/anchors/company-ca.pem

# Rocky 8.6 fixed AppStream repositories may not contain python3.12 RPMs.
# Leave blank to use the preinstalled stable runtime from
# /opt/simdashboard/runtime/python/bin/python3.12 when present, otherwise
# install python3.12/python3.12-pip through dnf. You may also set an absolute
# executable path to another preinstalled Python 3.12.13 runtime. Both
# preinstalled-runtime paths skip the Python RPMs; the runtime must provide
# venv and pip.
# PYTHON_BIN=/opt/simdashboard/runtime/python/bin/python3.12

# Paths and identities normally do not need changing.
INSTALL_ROOT=/opt/simdashboard
RUNTIME_DIRECTORY=/var/lib/simdashboard
# Master Result Refresh scans this single server-side folder. The installer
# creates the default local directory as root:simdashboard (0750), passes the
# value to systemd, and mounts it read-only for the service. An existing
# approved NAS/SMB/NFS path is not chmod/chown'ed, but must already grant the
# service user recursive read + traverse access.
SIMDASH_IMPORT_ROOT=/var/lib/simdashboard/import
# Production importer accepts only atomically published bundles with a valid
# `.simdashboard-ready.json` v1 marker. This is intentionally not configurable
# to legacy in the Rocky installer.
SIMDASH_IMPORT_READINESS_POLICY=required
# Rocky deployments default to the database-only media cutover. dual-read is
# accepted only as an explicit compatibility choice during migration.
SIMDASH_MEDIA_STORAGE_MODE=database-only
# Private importer snapshots are service-owned (0700) below RUNTIME_DIRECTORY;
# they are never written into the read-only import root. These values configure
# an application capacity/reserve gate, not a kernel/filesystem quota. Provision
# any dedicated filesystem quota separately before installation.
SIMDASH_IMPORT_SNAPSHOT_ROOT=/var/lib/simdashboard/snapshots
SIMDASH_IMPORT_SNAPSHOT_RESERVE_BYTES=1073741824
SIMDASH_IMPORT_SNAPSHOT_MIN_FREE_BYTES=536870912
SIMDASH_IMPORT_SNAPSHOT_STALE_SECONDS=86400
# The current implementation contract supports exactly 1 refresh at a time;
# Rocky's installer enforces this value.
SIMDASH_IMPORT_REFRESH_MAX_CONCURRENT=1
ENVIRONMENT_FILE=/etc/simdashboard/simdashboard.env
SERVICE_USER=simdashboard
SERVICE_GROUP=simdashboard
# POSTGRES_BIN=/usr/pgsql-18/bin

# Optional URL checked after the direct API health check. Use the public HTTPS
# URL when its DNS and CA trust are already available on the server.
HEALTHCHECK_URL=
