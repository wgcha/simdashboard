[Unit]
Description=Analysis Canvas API (__REPLACE_ENVIRONMENT__)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=__REPLACE_IMPORT_ROOT__

[Service]
Type=exec
User=__REPLACE_SERVICE_USER__
Group=__REPLACE_SERVICE_GROUP__
WorkingDirectory=__REPLACE_RELEASE_ROOT__/backend
EnvironmentFile=__REPLACE_ENVIRONMENT_FILE__
Environment=PYTHONUNBUFFERED=1
Environment=ANALYSIS_DB_BACKEND=postgresql
ExecStartPre=__REPLACE_RELEASE_ROOT__/.venv/bin/python __REPLACE_RELEASE_ROOT__/backend/scripts/check_deployment_profile.py
ExecStart=__REPLACE_RELEASE_ROOT__/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port __REPLACE_API_PORT__ --workers __REPLACE_UVICORN_WORKERS__ --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=__REPLACE_RUNTIME_DIRECTORY__
ReadOnlyPaths=__REPLACE_IMPORT_ROOT__
UMask=0027

[Install]
WantedBy=multi-user.target
