# PostgreSQL is the default backend. Set ANALYSIS_DB_BACKEND=duckdb only for
# an existing legacy local installation; that explicit setting remains supported.
ANALYSIS_DB_BACKEND=postgresql
# DATABASE_URL is required when PostgreSQL is selected.
# DATABASE_URL=postgresql+psycopg://simdashboard_app:CHANGE_ME@127.0.0.1:5432/simulation_dashboard
# DuckDB compatibility settings (used only with ANALYSIS_DB_BACKEND=duckdb):
# ANALYSIS_DUCKDB_PATH=C:/simulation-data/analysis_dashboard.duckdb

# Trusted server-owned result root. The refresh API never accepts a client path.
# Local example: /home/<user>/simdashboard-results
# Rocky candidate: /var/lib/simdashboard/import
# SIMDASH_IMPORT_ROOT=/absolute/path/to/master-results
# SPDM project/request source folders (separate writable storage adapter).
# Omit to configure the root in the administrator storage panel.
# An environment value takes precedence over the saved UI setting.
# SIMDASH_SPDM_ROOT=D:/SPDM
# SIMDASH_SPDM_ROOT=\\server\share\SPDM
# Local/default compatibility: unmarked legacy bundles remain discoverable.
# Rocky production installation pins this to `required`; do not relax it there.
SIMDASH_IMPORT_READINESS_POLICY=legacy
# Media reads use database blobs when cut over; dual-read retains legacy file_path fallback.
SIMDASH_MEDIA_STORAGE_MODE=dual-read
# Optional private importer snapshot overrides. Leave these commented to retain
# the local defaults; Rocky's installer supplies its own /var/lib paths.
# This is an application capacity/reserve gate, not a kernel/filesystem quota.
# Provision a dedicated filesystem quota separately when the deployment needs one.
# SIMDASH_IMPORT_SNAPSHOT_ROOT=/absolute/path/to/private-snapshots
# SIMDASH_IMPORT_SNAPSHOT_RESERVE_BYTES=1073741824
# SIMDASH_IMPORT_SNAPSHOT_MIN_FREE_BYTES=536870912
# SIMDASH_IMPORT_SNAPSHOT_STALE_SECONDS=86400
# The current implementation contract supports exactly 1 refresh at a time.
# SIMDASH_IMPORT_REFRESH_MAX_CONCURRENT=1
# Canonical bundle capture limits (bytes/count; finite safety ceilings)
# SIMDASH_IMPORT_MAX_MANIFEST_BYTES=1048576
# SIMDASH_IMPORT_MAX_MAPPING_COUNT=128
# SIMDASH_IMPORT_MAX_FILE_BYTES=536870912
# SIMDASH_IMPORT_MAX_TOTAL_BYTES=1073741824
# SIMDASH_IMPORT_MAX_STRUCTURED_BYTES=8388608 (typed_scalars/curve_csv; copy 전 적용, hard max 64MiB)
# SIMDASH_IMPORT_MAX_SCALAR_RECORDS=100000
# SIMDASH_IMPORT_MAX_CURVES=128
# SIMDASH_IMPORT_MAX_CURVE_POINTS=100000
# Manifest event ceiling = 256 + 64 * SIMDASH_IMPORT_MAX_MAPPING_COUNT;
# scalar 단일 item event ceiling = 64 (환경변수로 늘리지 않음)

# PostgreSQL service connection (use simdashboard_app after migration/seed)
# setup-postgresql stores the owner connection separately in the gitignored
# .postgres-owner.env file. The application process does not load that file.

# One-time PostgreSQL bootstrap/migration values. Never commit real passwords.
# POSTGRES_ADMIN_URL=postgresql://postgres:ADMIN_PASSWORD@127.0.0.1:5432/postgres
SIM_DASH_DATABASE=simulation_dashboard
SIM_DASH_OWNER_ROLE=simdashboard_owner
SIM_DASH_APP_ROLE=simdashboard_app
# SIM_DASH_OWNER_PASSWORD=CHANGE_ME
# SIM_DASH_APP_PASSWORD=CHANGE_ME

# External deployment settings (configure before network exposure)
# Windows password/SSO installs default to LAN access; unauthenticated dev stays local.
# Explicit host/path values survive git pull/update.bat. Use loopback for an HTTPS proxy:
# WINDOWS_WEB_HOST=127.0.0.1
# WINDOWS_WEB_HOST=0.0.0.0
# Default URL: http://COMPUTER-NAME/home/ or http://CORPORATE-IP/home/ (port 80).
# WINDOWS_WEB_BASE_PATH=/home/
# Web port (default 80). Use another port when 80 is taken, e.g. by IIS.
# WINDOWS_WEB_PORT=8080
# See docs/windows-lan-access.md for restart, firewall and HTTPS instructions.
DEPLOYMENT_PROFILE=local
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# deploy.bat automatically prompts for the first password administrator.
# setup-accounts.bat remains a manual recovery tool. Signup waits for readiness.
AUTH_MODE=disabled
# The disabled local principal is only available with both values below. It is
# intentionally an explicit development escape, never an installation default.
# DEPLOYMENT_PROFILE=local
# AUTH_ALLOW_INSECURE_LOCAL=true
# Password mode enables personal signup only after an ACTIVE password admin exists.
# AUTH_MODE=password
# AUTH_SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TOKEN_TTL_MINUTES=480
# HTTPS reverse proxy deployment should use true.
AUTH_COOKIE_SECURE=false
# Windows-built helper ZIP + distribution-manifest.json; default: dist/local-helper/windows-x64
# LOCAL_HELPER_DISTRIBUTION_DIR=/opt/simulation-workbench/local-helper/windows-x64

# Runtime outbound proxy is separate from the Vite/nginx reverse proxy.
# Prefer an OS/service secret store when credentials are required; never commit them.
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=127.0.0.1,localhost,::1

# Windows VM intranet production profile (all values are required; no local fallback)
# DEPLOYMENT_PROFILE=windows-vm-intranet
# AUTH_MODE=oidc
# AUTH_SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# AUTH_COOKIE_SECURE=true
# OIDC_ISSUER_URL=https://idp.intranet.example
# OIDC_CLIENT_ID=analysis-canvas
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_REDIRECT_URI=https://analysis.intranet.example/api/auth/oidc/callback
# OIDC_LOGIN_SUCCESS_URL=https://analysis.intranet.example/
# OIDC_LOGIN_FAILURE_URL=https://analysis.intranet.example/login
# DIRECTORY_MODE=http
# DIRECTORY_API_BASE_URL=https://directory.intranet.example
# DIRECTORY_API_SEARCH_PATH=/employees/search
# DIRECTORY_API_TOKEN=CHANGE_ME
# DIRECTORY_API_TIMEOUT_SECONDS=3
# DIRECTORY_API_RESULT_LIMIT=20
# Windows example when PostgreSQL bin is not on PATH:
# POSTGRES_BIN=E:\PostgreSQL\18\bin

# Windows password server profile: PostgreSQL behind trusted HTTPS, secure cookie.
# DEPLOYMENT_PROFILE=windows-password-intranet
# ANALYSIS_DB_BACKEND=postgresql
# AUTH_MODE=password
# AUTH_SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# AUTH_COOKIE_SECURE=true

# SPDM 새 프로젝트·의뢰 폴더 자동 탐색(docs/features/folder-schema-refresh.md). 기본 켜짐;
# 0/false/off/no면 끈다(격리된 e2e 실행기용). 배포는 기본값을 둔다.
# SIMDASH_AUTO_DISCOVERY=1

# SCX 드라이브 연동(docs/features/scx-drive.md §3). 기본 none: 아래 값이 없으면 지금과 같다.
# none 또는 scx. scx면 기동 시 설정·어댑터·단일 프로세스를 확인하고 어긋나면 기동을 거부한다.
# SIMDASH_DRIVE_GATEWAY=none
# 워커 런타임 python.exe 절대 경로(scx 필수, 파일이 있어야 함).
# SIMDASH_SCX_WORKER_PYTHON=C:\SimulationWorkbench\scx-worker\venv\Scripts\python.exe
# 드라이브 서버 https://<호스트>/ (scx 필수). 토큰 등록 시 server_url 호스트와 같아야 한다.
# SIMDASH_SCX_SERVER_URL=https://scx.intranet.example/
# SSO 클라이언트 ID(scx 필수, HPC_SDK와 같은 값).
# SIMDASH_SCX_CLIENT_NAME=drive-desktop
# 토큰 암호화 Fernet 키(32바이트 urlsafe base64; scx 필수). AUTH_SECRET_KEY와 같으면 거부.
# SIMDASH_SECRET_ENC_KEY=GENERATE_A_FERNET_KEY
# SPDM 루트: 공용 계정 홈(~) 기준 상대 경로. scx 모드의 SPDM 루트는 이 값뿐이다(없으면 "루트 미설정").
# SIMDASH_SCX_DRIVE_ROOT=SPDM/Projects
# 드라이브 쓰기 허용(기본 false; true/false/1/0/on/off). 켜면 업로드 대기열이 결과 등록·Final 지정을 드라이브에 쓴다(§10).
# SIMDASH_DRIVE_WRITES_ENABLED=false
# 대기열 항목 하나의 재시도 가능 오류 최대 시도 수(1–100, 기본 8). 넘으면 FAILED.
# SIMDASH_DRIVE_UPLOAD_MAX_ATTEMPTS=8
# 같은 이름 파일을 내려받아 sha256으로 비교하는 크기 상한(기본 2 GiB, 0이면 비교 안 함). 넘으면 비교 없이 CONFLICT.
# SIMDASH_DRIVE_VERIFY_MAX_BYTES=2147483648
# 32 MiB 초과 다운로드 파일의 서버 보관소(기본 <WORK_DIR>\blobs). 백업 대상 아님.
# SIMDASH_DRIVE_BLOB_DIR=D:\SimulationWorkbench\scx-worker\blobs
# 보관소 용량 상한(기본 100 GiB). 넘으면 가장 오래 쓰지 않은 파일부터 지운다.
# SIMDASH_DRIVE_BLOB_MAX_BYTES=107374182400
# 사내 CA 번들 pem 절대 경로(권장).
# SIMDASH_SCX_CA_BUNDLE=C:\SimulationWorkbench\certs\corp-ca.pem
# 워커 TEMP·adcopy 로그·dashboard.lock(기본 backend\data\scx-worker). 서버는 릴리스 폴더 밖 경로 권장.
# SIMDASH_SCX_WORK_DIR=D:\SimulationWorkbench\scx-worker
# 다운로드·업로드 임시 저장소(기본 <WORK_DIR>\staging). 대시보드 서비스 계정만 접근.
# SIMDASH_SCX_STAGING_DIR=D:\SimulationWorkbench\scx-worker\staging
# 워커 동시 SDK 호출 수(1–8, 기본 1).
# SIMDASH_SCX_MAX_CONCURRENCY=1
# 어댑터 목록·조회 캐시(0–3600초, 기본 30).
# SIMDASH_SCX_CACHE_TTL_SECONDS=30
# 드라이브 재연결 화면의 계정 로그인(아이디·비밀번호, 이슈 #50). off / https_only(기본) / on.
# https_only: HTTPS 접속(같은 PC의 Caddy가 붙이는 X-Forwarded-Proto를 uvicorn이 신뢰한 값) 또는
# 같은 PC 직접 접속(127.0.0.1·::1, 프록시 헤더 없음)만 허용. HTTP 사내망에서는 비밀번호가 평문으로 흐르므로 on은 비권장.
# SIMDASH_DRIVE_PASSWORD_LOGIN=https_only
# 계정 로그인 시도 한도(대시보드 전체, 15분당, 1–20, 기본 3). 넘으면 15분 잠금(HPC 계정 잠금 방지).
# SIMDASH_DRIVE_LOGIN_MAX_ATTEMPTS=3
# 사용환경 소재(OptiStruct .fem) 분석 한도(docs/features/materials-optistruct.md).
# 입력+INCLUDE 합계 바이트 상한(1 MiB–16 GiB, 기본 2 GiB). 초과 시 413 MATERIALS_FILE_SIZE_LIMIT.
# SIMDASH_OPTISTRUCT_MAX_BYTES=2147483648
# 분석 하나의 시간 상한(10초–4시간, 기본 1800초).
# SIMDASH_OPTISTRUCT_MAX_SECONDS=1800

# Optional absolute persistent attachment/template directory. Offline installers
# set this automatically outside the versioned release directory.
# SIMDASH_ASSETS_ROOT=C:\ProgramData\SimulationWorkbench\state\assets
# 서버가 직접 새 결과를 확인하는 주기(초, 기본 300 = 5분, 0이면 끔, 60 미만은 60). 화면을 열어 두지 않아도 새 Case·Scene이 반영되고 알림이 갑니다.
# SIMDASH_RESULT_AUTO_SYNC_SECONDS=300
